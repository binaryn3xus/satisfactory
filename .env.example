# =============================================================================
# Satisfactory Dedicated Server & Portal Environment Configuration
# =============================================================================

# Server Gameplay & Network Settings
SERVER_NAME=Satisfactory-Server
SERVER_GAME_PORT=7777
SERVER_MESSAGING_PORT=8888
PORTAL_PORT=8081
MAX_PLAYERS=8
MAX_TICK_RATE=30
AUTOSAVE_NUM=5
AUTOSAVE_INTERVAL=300
AUTO_PAUSE=true

# Engine & Steam Settings
STEAM_BRANCH=public
STEAM_UPDATE_ON_START=true
BACKUP_KEEP_COUNT=5

# Declarative Modding (ficsit-cli)
MODS_ENABLED=false
MODS_STRICT_MODE=true
MODS_PROFILE=default
MODS_UPDATE_POLICY=always
MODS_LIST=
MODS_CLIENT_ONLY=

# Notifications & Webhooks (Optional)
DISCORD_WEBHOOK_URL=

# User & Permission Settings
PUID=1000
PGID=1000
